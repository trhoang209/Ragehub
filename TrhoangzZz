local function addColorPicker(page, order, labelText, getColor, setColor)
    local row = makeRow(page, order, 27)
    makeLabel(row, labelText)
    local colorBtn = Instance.new("TextButton")
    colorBtn.Size = UDim2.fromOffset(58, 19)
    colorBtn.Position = UDim2.new(1, -66, 0.5, -9)
    colorBtn.BackgroundColor3 = getColor()
    colorBtn.Text = ""
    colorBtn.AutoButtonColor = false
    colorBtn.BorderSizePixel = 0
    colorBtn.Parent = row
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = colorBtn
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(80, 80, 90)
    btnStroke.Thickness = 1
    btnStroke.Parent = colorBtn

    -- panel lưới ô màu
    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(1, 0, 0, 0)
    panel.AutomaticSize = Enum.AutomaticSize.Y
    panel.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    panel.BorderSizePixel = 0
    panel.LayoutOrder = order + 0.5
    panel.Visible = false
    panel.Parent = page
    local panelCorner = Instance.new("UICorner")
    panelCorner.CornerRadius = UDim.new(0, 6)
    panelCorner.Parent = panel
    local panelPad = Instance.new("UIPadding")
    panelPad.PaddingTop = UDim.new(0, 8)
    panelPad.PaddingBottom = UDim.new(0, 8)
    panelPad.PaddingLeft = UDim.new(0, 9)
    panelPad.PaddingRight = UDim.new(0, 9)
    panelPad.Parent = panel

    -- grid 8 cột x 4 hàng = 32 ô
    local gridFrame = Instance.new("Frame")
    gridFrame.Size = UDim2.new(1, 0, 0, 104)
    gridFrame.BackgroundTransparency = 1
    gridFrame.Parent = panel

    local cellSize = 20
    local cellGap = 4
    local cols = 8
    local rows = 4
    local totalW = cols * cellSize + (cols - 1) * cellGap
    local startX = (gridFrame.AbsoluteSize.X - totalW) * 0.5
    -- dùng AbsoluteSize.X sau khi render, tính lại khi visible
    local function layoutCells()
        local gw = gridFrame.AbsoluteSize.X
        if gw <= 0 then gw = 170 end
        local sx = (gw - totalW) * 0.5
        for i, color in ipairs(COLOR_PRESETS) do
            local col = (i - 1) % cols
            local row = math.floor((i - 1) / cols)
            local cell = gridFrame:FindFirstChild("cell_" .. i)
            if cell then
                cell.Position = UDim2.fromOffset(sx + col * (cellSize + cellGap), 8 + row * (cellSize + cellGap))
            end
        end
    end

    for i, color in ipairs(COLOR_PRESETS) do
        local cell = Instance.new("TextButton")
        cell.Name = "cell_" .. i
        cell.Size = UDim2.fromOffset(cellSize, cellSize)
        cell.BackgroundColor3 = color
        cell.Text = ""
        cell.AutoButtonColor = false
        cell.BorderSizePixel = 0
        cell.Parent = gridFrame
        local cellCorner = Instance.new("UICorner")
        cellCorner.CornerRadius = UDim.new(0, 4)
        cellCorner.Parent = cell
        local cellStroke = Instance.new("UIStroke")
        cellStroke.Color = Color3.fromRGB(60, 60, 70)
        cellStroke.Thickness = 1
        cellStroke.Parent = cell
        cell.MouseButton1Click:Connect(function()
            setColor(color)
            colorBtn.BackgroundColor3 = color
        end)
        cell.MouseEnter:Connect(function()
            TweenService:Create(cellStroke, TweenInfo.new(0.1), { Color = Color3.fromRGB(200, 200, 220), Thickness = 2 }):Play()
        end)
        cell.MouseLeave:Connect(function()
            TweenService:Create(cellStroke, TweenInfo.new(0.1), { Color = Color3.fromRGB(60, 60, 70), Thickness = 1 }):Play()
        end)
    end

    colorBtn.MouseButton1Click:Connect(function()
        panel.Visible = not panel.Visible
        if panel.Visible then task.spawn(layoutCells) end
    end)

    table.insert(refreshFns, function()
        colorBtn.BackgroundColor3 = getColor()
    end)
end

