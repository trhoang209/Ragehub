    valLbl.BackgroundTransparency = 1
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.TextColor3 = THEME.accent1
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 11
    valLbl.Parent = row
    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -18, 0, 4)
    track.Position = UDim2.new(0, 9, 0, 27)
    track.BackgroundColor3 = Color3.fromRGB(48, 48, 58)
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = THEME.accent1
    fill.BorderSizePixel = 0
    fill.Parent = track
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(0, -6, 0.5, -6)
    knob.BackgroundColor3 = THEME.knob
    knob.BorderSizePixel = 0
    knob.Parent = track
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    local function refresh()
        local v = math.clamp(get(), min, max)
        local f = (v - min) / (max - min)
        fill.Size = UDim2.fromScale(f, 1)
        knob.Position = UDim2.new(f, -6, 0.5, -6)
        valLbl.Text = tostring(math.floor(v + 0.5))
    end
    local sliding = false
    local function updateFromX(x)
        local absX = track.AbsolutePosition.X
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local f = math.clamp((x - absX) / w, 0, 1)
        set(min + (max - min) * f)
        refresh()
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateFromX(input.Position.X)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then sliding = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not sliding then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end)
    refresh()
    table.insert(refreshFns, refresh)
end

