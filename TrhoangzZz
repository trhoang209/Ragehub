local function revealStep()
    if not CONFIG.reveal then return end
    for _, e in pairs(cache) do
        for i = 1, #e.parts do
            local part = e.parts[i]
            if part and part.Parent and part.Name ~= "HumanoidRootPart" then
                if part.LocalTransparencyModifier ~= 0 then part.LocalTransparencyModifier = 0 end
                if part.Transparency > 0.95 then part.Transparency = 0 end
            end
        end
    end
end

