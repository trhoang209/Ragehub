--------------------------------------------------------------------
-- FIX LAG
--------------------------------------------------------------------
local originalLighting = {}

local function applyFixLag(on)
    if not on then
        if originalLighting.GlobalShadows ~= nil then Lighting.GlobalShadows = originalLighting.GlobalShadows end
        if originalLighting.Brightness ~= nil then Lighting.Brightness = originalLighting.Brightness end
        if originalLighting.OutdoorAmbient ~= nil then Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient end
        if originalLighting.FogEnd ~= nil then Lighting.FogEnd = originalLighting.FogEnd end
        pcall(function() UserGameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel0 end)
        return
    end
    originalLighting.GlobalShadows = Lighting.GlobalShadows
    originalLighting.Brightness = Lighting.Brightness
    originalLighting.OutdoorAmbient = Lighting.OutdoorAmbient
    originalLighting.FogEnd = Lighting.FogEnd
    Lighting.GlobalShadows = false
    Lighting.Brightness = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    Lighting.FogEnd = 5000
    pcall(function() UserGameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel0 end)
    pcall(function()
        if Workspace.Terrain then Workspace.Terrain.MaxExtents = Vector3.new(4000, 400, 4000) end
    end)
end

--------------------------------------------------------------------
-- DRAWING HELPERS
--------------------------------------------------------------------
local function makeSquare(filled)
    if not DRAWING_OK then return nil end
    local ok, s = pcall(function() return Drawing.new("Square") end)
    if not ok or not s then return nil end
    s.Filled = filled == true
    s.Visible = false
    return s
end

local function makeLine()
    if not DRAWING_OK then return nil end
    local ok, l = pcall(function() return Drawing.new("Line") end)
    if not ok or not l then return nil end
    l.Visible = false
    return l
end

local function makeText(size)
    if not DRAWING_OK then return nil end
    local ok, t = pcall(function() return Drawing.new("Text") end)
    if not ok or not t then return nil end
    t.Size = size
    t.Center = true
    t.Outline = true
    t.OutlineColor = Color3.new(0, 0, 0)
    t.Visible = false
    pcall(function() t.Font = 2 end)
    pcall(function() t.Font = Enum.Font.Code end)
    return t
end

local function buildEntry()
    local e = { d = {}, motors = {}, parts = {}, bonePool = {}, corners = {}, highlight = nil }
    e.d.outline = makeSquare(false)
    if e.d.outline then
        e.d.outline.Thickness = CONFIG.boxThickness + 1
        e.d.outline.Color = CONFIG.outlineColor
    end
    e.d.box = makeSquare(false)
    if e.d.box then e.d.box.Thickness = CONFIG.boxThickness end
    e.d.fill = makeSquare(true)
    e.d.tracer = makeLine()
    e.d.name = makeText(CONFIG.textSize)
    e.d.barBg = makeSquare(true)
    e.d.barFill = makeSquare(true)
    for i = 1, MAX_BONES * 2 do e.bonePool[i] = makeLine() end
    for i = 1, 16 do e.corners[i] = makeSquare(true) end
    return e
end

local cache = {}

local function entryFor(player)
    local e = cache[player]
    if not e then e = buildEntry(); cache[player] = e end
    return e
end

local function hideBones(e)
    for i = 1, #e.bonePool do
        local line = e.bonePool[i]
        if line and line.Visible then line.Visible = false end
    end
end

local function hideBoxParts(e)
    if e.d.box and e.d.box.Visible then e.d.box.Visible = false end
    if e.d.outline and e.d.outline.Visible then e.d.outline.Visible = false end
    if e.d.fill and e.d.fill.Visible then e.d.fill.Visible = false end
    for i = 1, #e.corners do
        local s = e.corners[i]
        if s and s.Visible then s.Visible = false end
    end
end

local function hideOverlay(e)
    hideBoxParts(e)
    hideBones(e)
    if e.d.name then e.d.name.Visible = false end
    if e.d.barBg then e.d.barBg.Visible = false end
    if e.d.barFill then e.d.barFill.Visible = false end
end

local function hideEntry(e)
    hideOverlay(e)
    if e.d.tracer and e.d.tracer.Visible then e.d.tracer.Visible = false end
    if e.highlight then pcall(function() e.highlight.Enabled = false end) end
end

local function killEntry(e)
    for _, obj in pairs(e.d) do pcall(function() obj:Remove() end) end
    for i = 1, #e.bonePool do pcall(function() e.bonePool[i]:Remove() end) end
    for i = 1, #e.corners do pcall(function() e.corners[i]:Remove() end) end
    if e.highlight then pcall(function() e.highlight:Destroy() end) end
end

--------------------------------------------------------------------
-- FILTERS + PROJECTION
--------------------------------------------------------------------
local function isAlly(player)
    local mt, pt = LocalPlayer.Team, player.Team
    if mt ~= nil and pt ~= nil then return mt == pt end
    return false
end

local function passesFilter(player)
    local ally = isAlly(player)
    if CONFIG.alliesOnly then return ally end
    if CONFIG.teamCheck and LocalPlayer.Team ~= nil then return not ally end
    return true
end

local function toScreen(worldPos)
    local v, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(v.X, v.Y), onScreen, v.Z
end

local function screenCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end

local function projectBox(character)
    local head = character:FindFirstChild("Head")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return nil end
    if not head:IsA("BasePart") or not hrp:IsA("BasePart") then return nil end
    local topWorld = Vector3.new(hrp.Position.X, head.Position.Y + (head.Size.Y * 0.5) + 0.35, hrp.Position.Z)
    local bottomWorld = Vector3.new(hrp.Position.X, hrp.Position.Y - (hrp.Size.Y * 0.5) - 2.15, hrp.Position.Z)
    local top, topOn = toScreen(topWorld)
    local bot, botOn = toScreen(bottomWorld)
    if not topOn or not botOn then return nil end
    local height = bot.Y - top.Y
    if height < 4 then return nil end
    return {
        x = top.X - (height * 0.25),
        y = top.Y,
        w = height * 0.5,
        h = height,
        distance = (hrp.Position - Camera.CFrame.Position).Magnitude,
    }
end

local function healthFraction(character)
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local maxH = hum.MaxHealth
    if not maxH or maxH <= 0 then maxH = 100 end
    return math.clamp(hum.Health, 0, maxH) / maxH
end

--------------------------------------------------------------------
-- BOX STYLES
--------------------------------------------------------------------
local function drawCornerBox(e, geo, color)
    local t = CONFIG.boxThickness
    local armX = math.max(geo.w * 0.30, 8)
    local armY = math.max(geo.h * 0.30, 8)
    local arms = {
        { Vector2.new(geo.x, geo.y), Vector2.new(armX, t) },
        { Vector2.new(geo.x, geo.y), Vector2.new(t, armY) },
        { Vector2.new(geo.x + geo.w - armX, geo.y), Vector2.new(armX, t) },
        { Vector2.new(geo.x + geo.w - t, geo.y), Vector2.new(t, armY) },
        { Vector2.new(geo.x, geo.y + geo.h - t), Vector2.new(armX, t) },
        { Vector2.new(geo.x, geo.y + geo.h - armY), Vector2.new(t, armY) },
        { Vector2.new(geo.x + geo.w - armX, geo.y + geo.h - t), Vector2.new(armX, t) },
        { Vector2.new(geo.x + geo.w - t, geo.y + geo.h - armY), Vector2.new(t, armY) },
    }
    for i, arm in ipairs(arms) do
        local back = e.corners[i * 2 - 1]
        local face = e.corners[i * 2]
        if back then
            back.Size = arm[2] + Vector2.new(2, 2)
            back.Position = arm[1] - Vector2.new(1, 1)
            back.Color = CONFIG.outlineColor
            back.Visible = true
        end
        if face then
            face.Size = arm[2]
            face.Position = arm[1]
            face.Color = color
            face.Visible = true
        end
    end
end

local function drawSolidBox(e, geo, color)
    if e.d.outline then
        e.d.outline.Size = Vector2.new(geo.w + 2, geo.h + 2)
        e.d.outline.Position = Vector2.new(geo.x - 1, geo.y - 1)
        e.d.outline.Thickness = CONFIG.boxThickness + 1
        e.d.outline.Visible = true
    end
    if e.d.box then
        e.d.box.Size = Vector2.new(geo.w, geo.h)
        e.d.box.Position = Vector2.new(geo.x, geo.y)
        e.d.box.Color = color
        e.d.box.Thickness = CONFIG.boxThickness
        e.d.box.Visible = true
    end
end

local function drawFilledBox(e, geo, color)
    if e.d.fill then
        e.d.fill.Size = Vector2.new(geo.w, geo.h)
        e.d.fill.Position = Vector2.new(geo.x, geo.y)
        e.d.fill.Color = color
        e.d.fill.Transparency = 0.72
        e.d.fill.Visible = true
    end
    drawSolidBox(e, geo, color)
end

--------------------------------------------------------------------
-- HIGHLIGHT
--------------------------------------------------------------------
local function attachHighlight(player)
    local character = player.Character
    if not character then return end
    local e = entryFor(player)
    if e.highlight and e.highlight.Parent == character then return end
    if e.highlight then pcall(function() e.highlight:Destroy() end) end
    pcall(function()
        local hl = Instance.new("Highlight")
        hl.Name = "__ragehub_esp"
        hl.FillTransparency = 0.72
        hl.OutlineTransparency = 0.15
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = false
        hl.Parent = character
        e.highlight = hl
    end)
end

--------------------------------------------------------------------
-- CHARACTER WIRING
--------------------------------------------------------------------
local function collectMotors(character, e)
    table.clear(e.motors)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Motor6D") and #e.motors < MAX_BONES then table.insert(e.motors, obj) end
    end
end

local function collectParts(character, e)
    table.clear(e.parts)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then table.insert(e.parts, obj) end
    end
end

local function onCharacter(player, character)
    local e = entryFor(player)
    hideEntry(e)
    table.clear(e.motors)
    local hum = character:WaitForChild("Humanoid", 5)
    if not hum then return end
    collectMotors(character, e)
    collectParts(character, e)
    if CONFIG.highlight then attachHighlight(player) end
    character.DescendantAdded:Connect(function(obj)
        if obj:IsA("Motor6D") and #e.motors < MAX_BONES then table.insert(e.motors, obj)
        elseif obj:IsA("BasePart") then table.insert(e.parts, obj) end
    end)
end

--------------------------------------------------------------------
-- RENDER ESP
--------------------------------------------------------------------
local enemyCount = 0

local function renderPlayer(player)
    local e = entryFor(player)
    local character = player.Character
    if not character then hideEntry(e); return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then hideEntry(e); return end
    if not CONFIG.showDead and hum.Health <= 0 then hideEntry(e); return end
    if not passesFilter(player) then hideEntry(e); return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local dist = math.huge
    if hrp then dist = (hrp.Position - Camera.CFrame.Position).Magnitude end
    if dist > CONFIG.maxDistance then hideEntry(e); return end
    local geo = projectBox(character)

    if CONFIG.tracer and e.d.tracer then
        if geo then
            e.d.tracer.From = Vector2.new(Camera.ViewportSize.X * 0.5, CONFIG.tracerOriginY)
            e.d.tracer.To = Vector2.new(geo.x + geo.w * 0.5, geo.y)
            e.d.tracer.Color = CONFIG.tracerColor
            e.d.tracer.Thickness = 1
            e.d.tracer.Visible = true
            if not isAlly(player) then enemyCount = enemyCount + 1 end
        else
            e.d.tracer.Visible = false
        end
    elseif e.d.tracer then
        e.d.tracer.Visible = false
    end

    if not geo then hideOverlay(e); return end

    local teamColor = isAlly(player) and CONFIG.allyColor or CONFIG.enemyColor

    hideBoxParts(e)
    if CONFIG.box then
        if CONFIG.boxStyle == "Corner" then drawCornerBox(e, geo, CONFIG.boxColor)
        elseif CONFIG.boxStyle == "Filled" then drawFilledBox(e, geo, CONFIG.boxColor)
        else drawSolidBox(e, geo, CONFIG.boxColor) end
    end

    if CONFIG.nameTag and e.d.name then
        local label = player.DisplayName
        if label == nil or label == "" then label = player.Name end
        e.d.name.Text = label
        e.d.name.Position = Vector2.new(geo.x + geo.w * 0.5, geo.y - CONFIG.textSize - 5)
        e.d.name.Color = teamColor
        e.d.name.Visible = true
    elseif e.d.name then
        e.d.name.Visible = false
    end

    local frac = healthFraction(character)
    if CONFIG.healthBar and frac and e.d.barBg and e.d.barFill then
        -- gap 4px giữa box và health bar
        local bx = geo.x - CONFIG.barWidth - 4
        e.d.barBg.Size = Vector2.new(CONFIG.barWidth + 2, geo.h + 2)
        e.d.barBg.Position = Vector2.new(bx - 1, geo.y - 1)
        e.d.barBg.Color = CONFIG.outlineColor
        e.d.barBg.Visible = true
        local fh = geo.h * frac
        e.d.barFill.Size = Vector2.new(CONFIG.barWidth, fh)
        e.d.barFill.Position = Vector2.new(bx, geo.y + geo.h - fh)
        e.d.barFill.Color = CONFIG.healthColor
        e.d.barFill.Visible = true
    else
        if e.d.barBg then e.d.barBg.Visible = false end
        if e.d.barFill then e.d.barFill.Visible = false end
    end

    if CONFIG.bones then
        local used = 0
        local boneW = math.clamp(CONFIG.boneThickness * (350 / geo.distance), 0.75, 3)
        for i = 1, #e.motors do
            if used >= MAX_BONES then break end
            local m = e.motors[i]
            local p0, p1 = m.Part0, m.Part1
            if p0 and p1 and p0.Parent and p1.Parent then
                local a, aOn = toScreen(p0.Position)
                local b, bOn = toScreen(p1.Position)
                if aOn and bOn then
                    used = used + 1
                    local back = e.bonePool[used * 2 - 1]
                    local core = e.bonePool[used * 2]
                    if back then
                        back.From = a; back.To = b
                        back.Color = CONFIG.outlineColor
                        back.Thickness = boneW + 2
                        back.Visible = true
                    end
                    if core then
                        core.From = a; core.To = b
                        core.Color = CONFIG.boneColor
                        core.Thickness = boneW
                        core.Visible = true
                    end
                end
            end
        end
        for i = used * 2 + 1, #e.bonePool do
            local line = e.bonePool[i]
            if line and line.Visible then line.Visible = false end
        end
    else
        hideBones(e)
    end

    if CONFIG.highlight and e.highlight then
        pcall(function()
            e.highlight.FillColor = teamColor
            e.highlight.OutlineColor = teamColor
            e.highlight.Enabled = true
        end)
    end
end

