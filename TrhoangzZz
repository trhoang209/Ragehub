local function listenCarryState()
    local roots = { ReplicatedStorage:FindFirstChild("Network"), remoteRoot() }
    for _, root in ipairs(roots) do
        if root then
            local event = root:FindFirstChild("Eggs: AreaEggCarryState")
            if event and event:IsA("RemoteEvent") then
                event.OnClientEvent:Connect(function(data)
                    IS_CARRYING = type(data) == "table" and data.IsCarrying == true
                end)
                break
            end
        end
    end
end

local function main()
    buildPanel()
    _G.LunyxEggFarmController = {
        Stop = function()
            RUNNING = false
            STATUS = "Stopped"
            setPlayerControlsEnabled(true)
        end,
    }
    if CONFIG.ShowPanel and statusLabel then
        task.spawn(function()
            while RUNNING and statusLabel and statusLabel.Parent do
                statusLabel.Text = string.format(
                    "Status: %s\nStolen: %d | Placed: %d | Hatched: %d\nEquipped: %d | Failed: %d",
                    STATUS, STATS.stolen, STATS.placed, STATS.hatched, STATS.equipped, STATS.failed
                )
                task.wait(0.35)
            end
        end)
    end
    listenCarryState()
    claimOffline()

    while RUNNING do
        if not waitWhilePaused() then break end
        if not MY_PLOT and not resolvePlot() then
            STATUS = "Waiting for own base..."
            task.wait(2)
        else
            processBase()
            if IS_CARRYING then
                local before = recordCount(myEggRecords())
                if not carryHome() then
                    STATUS = "Carry return timed out - retrying"
                    task.wait(1.5)
                end
                processBase()
            else
                local candidates = getCandidates()
                if #candidates == 0 then
                    train()
                else
                    local target = candidates[1]
                    if stealEgg(target) then
                        local beforeCarry = recordCount(myEggRecords())
                        if not carryHome() then
                            -- Keep the carrying state set; the next loop will retry the route home.
                            STATUS = "Still carrying - returning again"
                            task.wait(1)
                        else
                            IS_CARRYING = false
                            processBase()
                        end
                    else
                        task.wait(0.5)
                    end
                end
            end
        end
        task.wait(CONFIG.LoopDelay)
    end

    STATUS = STOP_REASON or "Stopped"
    setPlayerControlsEnabled(true)
    if panel then panel:Destroy() end
    _G.LunyxEggFarmRunning = false
    _G.LunyxEggFarmController = nil
end

_G.LunyxEggFarmRunning = true

task.spawn(function()
    local ok, err = pcall(main)
    if not ok then
        warn("[Lunyx Egg Farm] " .. tostring(err))
        if panel then panel:Destroy() end
        setPlayerControlsEnabled(true)
        _G.LunyxEggFarmRunning = false
        _G.LunyxEggFarmController = nil
    end
end)
