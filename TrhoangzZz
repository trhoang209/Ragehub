local function characterParts()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return nil end
    return char, root, humanoid
end

local function walkSegment(destination, timeout)
    local _, root, humanoid = characterParts()
    if not root then return false end

    humanoid:MoveTo(destination)
    local started = os.clock()
    while RUNNING and os.clock() - started < (timeout or 10) do
        if not waitWhilePaused() then return false end
        local _, currentRoot = characterParts()
        if not currentRoot then return false end
        if (currentRoot.Position - destination).Magnitude <= 4.5 then return true end
        task.wait(0.12)
    end
    return false
end

local cachedControls
local function setPlayerControlsEnabled(enabled)
    if not cachedControls then
        local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
        local moduleScript = scripts and scripts:FindFirstChild("PlayerModule")
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, module = pcall(require, moduleScript)
            if ok and type(module) == "table" and type(module.GetControls) == "function" then
                local controlsOk, controls = pcall(function() return module:GetControls() end)
                if controlsOk then cachedControls = controls end
            end
        end
    end
    if cachedControls then
        pcall(function()
            if enabled then cachedControls:Enable() else cachedControls:Disable() end
        end)
    end
end

local function walkToCore(destination, tolerance)
    tolerance = tolerance or 5
    local _, root = characterParts()
    if not root then return false end
    if (root.Position - destination).Magnitude <= tolerance then return true end

    local deadline = os.clock() + CONFIG.MoveTimeout
    for attempt = 1, 3 do
        if not RUNNING or os.clock() > deadline then return false end
        if not waitWhilePaused() then return false end
        local _, currentRoot = characterParts()
        if not currentRoot then return false end

        local path = PathfindingService:CreatePath({
            AgentRadius = 2.5,
            AgentHeight = 6,
            AgentCanJump = true,
            WaypointSpacing = 7,
        })
        local ok = pcall(function() path:ComputeAsync(currentRoot.Position, destination) end)
        if ok and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            local reachedAll = true
            for index = 2, #waypoints do
                if not RUNNING or os.clock() > deadline then return false end
                if not waitWhilePaused() then return false end
                local wp = waypoints[index]
                local _, _, hum = characterParts()
                if not hum then return false end
                if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                local reached = walkSegment(wp.Position, math.min(12, math.max(3, deadline - os.clock())))
                if not reached then reachedAll = false break end
            end
            local _, finalRoot = characterParts()
            if reachedAll and finalRoot and (finalRoot.Position - destination).Magnitude <= tolerance + 3 then
                return true
            end
        else
            if not walkSegment(destination, math.min(10, math.max(3, deadline - os.clock()))) then
                task.wait(0.25)
            else
                return true
            end
        end
    end
    return false
end

local function walkTo(destination, tolerance)
    setPlayerControlsEnabled(false)
    local ok, result = pcall(walkToCore, destination, tolerance)
    setPlayerControlsEnabled(true)
    if not ok then
        warn("[Lunyx Egg Farm] movement error: " .. tostring(result))
        return false
    end
    return result == true
end

local function resolvePlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return false end

    local found
    local ok, state = invoke("PlotState")
    if ok and type(state) == "table" and type(state.OwnersBySlot) == "table" then
        for slot, ownerId in pairs(state.OwnersBySlot) do
            if tonumber(ownerId) == LocalPlayer.UserId then
                found = plots:FindFirstChild(tostring(slot))
                break
            end
        end
    end

    if not found then
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                for _, item in ipairs(sign:GetDescendants()) do
                    if item:IsA("TextLabel") and item.Text == LocalPlayer.Name then
                        found = plot
                        break
                    end
                end
            end
            if found then break end
        end
    end

    if not found then return false end
    local update = found:FindFirstChild("ToUpdate")
    local pen = update and update:FindFirstChild("PetArea")
    local center = found:FindFirstChild("CenterPoint") or pen
    if not pen or not center or not pen:IsA("BasePart") or not center:IsA("BasePart") then
        return false
    end

    MY_PLOT = found
    MY_PEN = pen
    MY_CENTER = center
    MY_TREADMILL = found:FindFirstChild("TreadmillBottom")
    return true
end

local function myEggRecords()
    local ok, snapshot = invoke("EggSnapshot")
    if not ok or type(snapshot) ~= "table" then return {} end
    local records = {}
    for _, ownerEntry in pairs(snapshot) do
        if type(ownerEntry) == "table" and tonumber(ownerEntry.OwnerUserId) == LocalPlayer.UserId then
            for uid, record in pairs(ownerEntry.Records or {}) do
                records[uid] = record
            end
        end
    end
    return records
end

local function myPetRecords()
    local ok, snapshot = invoke("PetSnapshot")
    if not ok or type(snapshot) ~= "table" then return {}, 0 end
    local pets, count = {}, 0
    for _, ownerEntry in pairs(snapshot) do
        if type(ownerEntry) == "table" and tonumber(ownerEntry.OwnerUserId) == LocalPlayer.UserId then
            for uid, record in pairs(ownerEntry.Records or {}) do
                pets[#pets + 1] = { uid = uid, income = tonumber(record.MoneyPerSecond) or 0 }
                count = count + 1
            end
        end
    end
    table.sort(pets, function(a, b) return a.income > b.income end)
    return pets, count
end

local function recordCount(records)
    local n = 0
    for _ in pairs(records) do n = n + 1 end
    return n
end

local function eggIncome(record)
    local definition = ASSETS[record.AssetCategory]
    if not definition then return 0 end
    local scale = tonumber(record.AssetScale or record.Scale) or 1
    local income = (tonumber(definition.EarningRate) or 0) * (scale ^ 1.85)
    local mutations = record.Mutations
    if type(mutations) == "table" then
        local count = 0
        for _ in pairs(mutations) do count = count + 1 end
        if count > 0 then income = income * (2.5 ^ count) end
    end
    return income
end

local function eggWeight(record)
    local definition = ASSETS[record.AssetCategory]
    return definition and definition.Egg and tonumber(definition.Egg.WeightKg) or 1
end

local function guardSpeed(areaId)
    local guard = GUARDS[areaId]
    return guard and tonumber(guard.WalkSpeed) or nil
end

local function getCandidates()
    local ok, snapshot = invoke("AreaEggs")
    if not ok or type(snapshot) ~= "table" then return {} end

    local _, root, humanoid = characterParts()
    if not root or not humanoid then return {} end

    local records = snapshot.Records or {}
    local candidates = {}
    for _, record in pairs(records) do
        if record.State == "Slot" and record.Uid and typeof(record.BottomCFrame) == "CFrame" then
            local distance = (record.BottomCFrame.Position - root.Position).Magnitude
            local weightMultiplier = math.clamp(1 - 0.04 * eggWeight(record), 0.25, 1)
            local required = guardSpeed(record.AreaId)
            local safe = not required or humanoid.WalkSpeed * weightMultiplier >= required * 0.9
            local income = eggIncome(record)
            if safe and distance <= CONFIG.MaxWalkDistance and income >= CONFIG.MinEggIncome then
                candidates[#candidates + 1] = {
                    record = record,
                    position = record.BottomCFrame.Position,
                    distance = distance,
                    income = income,
                }
            end
        end
    end

    table.sort(candidates, function(a, b)
        if CONFIG.PreferBestEgg and a.income ~= b.income then
            return a.income > b.income
        end
        return a.distance < b.distance
    end)
    return candidates
end

local function findCarryPrompt(position)
    local best, bestDistance
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("ProximityPrompt") and item.Name == "CarryAreaEgg" then
            local part = item.Parent
            if part and part:IsA("BasePart") then
                local distance = (part.Position - position).Magnitude
                if distance <= 15 and (not bestDistance or distance < bestDistance) then
                    best, bestDistance = item, distance
                end
            end
        end
    end
    return best
end

local function stealEgg(candidate)
    STATUS = "Walking to egg"
    if not walkTo(candidate.position, 4) then
        STATS.failed = STATS.failed + 1
        return false
    end
    local payload = { Uid = candidate.record.Uid }
    local ok, result = invoke("CarryEgg", payload)
    local carried = ok and (result == true or (type(result) == "table" and (result.Success == true or result.IsCarrying == true)))

    if not carried then
        local prompt = findCarryPrompt(candidate.position)
        if prompt and type(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, prompt, 1)
            carried = true
        end
    end

    if carried then
        IS_CARRYING = true
        STATS.stolen = STATS.stolen + 1
        return true
    end
    STATS.failed = STATS.failed + 1
    return false
end

local function carryHome()
    if not MY_PEN then return false end
    STATUS = "Returning to base"
    local before = recordCount(myEggRecords())
    local destination = MY_PEN.Position + Vector3.new(0, 4, 0)
    if not walkTo(destination, 6) then return false end

    local started = os.clock()
    while RUNNING and os.clock() - started < CONFIG.CarryTimeout do
        if not waitWhilePaused() then return false end
        local records = myEggRecords()
        if recordCount(records) > before then
            IS_CARRYING = false
            return true
        end
        task.wait(0.3)
    end
    return false
end

local function getFreeEggSpot(occupied)
    if not MY_PEN or not MY_CENTER then return nil end
    local maxX = math.max(3, MY_PEN.Size.X / 2 - 4)
    local maxZ = math.max(3, MY_PEN.Size.Z / 2 - 4)
    for x = -math.floor(maxX), math.floor(maxX), 4 do
        for z = -math.floor(maxZ), math.floor(maxZ), 4 do
            local world = MY_PEN.CFrame * CFrame.new(x, MY_PEN.Size.Y / 2 + 1.5, z)
            local clear = true
            for _, used in ipairs(occupied) do
                if (used - world.Position).Magnitude < 5.5 then clear = false break end
            end
            if clear then return world end
        end
    end
    return nil
end

local function placeEggs()
    if not CONFIG.AutoPlaceEggs or not MY_PEN or not MY_CENTER then return end
    local occupied, pending = {}, {}
    for uid, record in pairs(myEggRecords()) do
        if record.Placement and record.Placement.LocalCFrame then
            occupied[#occupied + 1] = (MY_CENTER.CFrame * record.Placement.LocalCFrame).Position
        elseif not record.Placement then
            pending[#pending + 1] = { uid = uid, record = record }
        end
    end

    for _, egg in ipairs(pending) do
        if not RUNNING then return end
        if not waitWhilePaused() then return end
        local worldCFrame = getFreeEggSpot(occupied)
        if not worldCFrame then break end
        local localCFrame = MY_CENTER.CFrame:ToObjectSpace(worldCFrame)
        local ok, result = invoke("PlaceEgg", {
            Uid = egg.uid,
            LocalCFrame = localCFrame,
        })
        if ok and result then
            STATS.placed = STATS.placed + 1
            occupied[#occupied + 1] = worldCFrame.Position
        end
        task.wait(0.2)
    end
end

local function hatchReadyEggs()
    if not CONFIG.AutoHatch then return end
    local now = workspace:GetServerTimeNow()
    for uid, record in pairs(myEggRecords()) do
        if not RUNNING then return end
        local placement = record.Placement
        if placement then
            local definition = ASSETS[record.AssetCategory]
            local baseTime = definition and definition.Egg and tonumber(definition.Egg.GrowthTime) or 30
            local speed = tonumber(record.GrowthSpeedMultiplier) or 1
            local placedAt = tonumber(placement.PlacedAt) or now
            if now - placedAt >= baseTime / math.max(0.01, speed) then
                local ok, result = invoke("HatchEgg", uid)
                if ok and result then
                    task.wait(0.8)
                    local finishOk, finishResult = invoke("FinishHatch", uid)
                    if finishOk and finishResult then STATS.hatched = STATS.hatched + 1 end
                end
                task.wait(0.2)
            end
        end
    end
end

local function equipNewPets()
    if not CONFIG.AutoEquipPets then return end
    local ok, limit = invoke("EquipLimit")
    if not ok or type(limit) ~= "number" then limit = 13 end
    local _, equippedCount = myPetRecords()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local containers = { backpack, LocalPlayer.Character }

    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool:GetAttribute("ItemType") == "Asset" then
                    local uid = tool:GetAttribute("UID")
                    if uid and equippedCount < limit then
                        local equipOk, result = invoke("EquipPet", uid)
                        if equipOk and result then
                            equippedCount = equippedCount + 1
                            STATS.equipped = STATS.equipped + 1
                        end
                        task.wait(0.15)
                    end
                end
            end
        end
    end
end

local function parseCash(text)
    local value, suffix = tostring(text):gsub("[$,%s]", ""):match("^([%d%.]+)([KMBTQkmb tq]?)$")
    if not value then return 0 end
    local mult = ({ K = 1e3, M = 1e6, B = 1e9, T = 1e12, Q = 1e15 })[(suffix or ""):upper()] or 1
    return (tonumber(value) or 0) * mult
end

local function cashAmount()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local moneyGui = gui and gui:FindFirstChild("Money")
    if not moneyGui then return 0 end
    for _, item in ipairs(moneyGui:GetDescendants()) do
        if item:IsA("TextLabel") and item.Name == "Money" then
            return parseCash(item.Text)
        end
    end
    return 0
end

local function upgradeTreadmill()
    if not CONFIG.AutoUpgradeTreadmill or type(TREADMILLS) ~= "table" then return end
    local saveDirectory, saveModule = requireDirectory("Shared.Save")
    if not saveDirectory then saveDirectory, saveModule = requireDirectory("Library.Modules.Save") end
    local save
    if saveModule and type(saveModule.Get) == "function" then
        local ok, data = pcall(saveModule.Get)
        if ok and type(data) == "table" then save = data end
    end
    local currentLevel = save and tonumber(save.TreadmillUpgradeLevel)
    if not currentLevel then return end

    local nextConfig
    if TREAD_MODULE and type(TREAD_MODULE.GetByUpgradeLevel) == "function" then
        local ok, config = pcall(TREAD_MODULE.GetByUpgradeLevel, currentLevel + 1)
        if ok and type(config) == "table" then nextConfig = config end
    end
    if not nextConfig then
        for _, config in pairs(TREADMILLS) do
            if tonumber(config.UpgradeLevel) == currentLevel + 1 then nextConfig = config break end
        end
    end
    if not nextConfig or not nextConfig._id then return end
    local price = tonumber(nextConfig.Price) or math.huge
    if cashAmount() - CONFIG.UpgradeCashReserve < price then return end
    invoke("TreadmillUp", nextConfig._id)
end

local function claimOffline()
    if not CONFIG.AutoClaimOffline then return end
    local ok, summary = invoke("OfflineSummary")
    if ok and type(summary) == "table" and (tonumber(summary.ClaimableAmount) or 0) > 0 then
        invoke("OfflineRedeem")
    end
end

local function train()
    if not CONFIG.AutoTrainWhenNoEggs or not MY_TREADMILL or not MY_TREADMILL:IsA("BasePart") then
        task.wait(2)
        return
    end
    STATUS = "Training on treadmill"
    local target = MY_TREADMILL.Position + Vector3.new(0, 4, 0)
    if walkTo(target, 5) then
        local start = os.clock()
        while RUNNING and os.clock() - start < CONFIG.TrainSeconds do
            if not waitWhilePaused() then return end
            local _, root = characterParts()
            if not root or (root.Position - target).Magnitude > 9 then
                walkTo(target, 5)
            end
            task.wait(0.5)
        end
    end
end

local function processBase()
    STATUS = "Managing base"
    placeEggs()
    hatchReadyEggs()
    equipNewPets()
    upgradeTreadmill()
end

