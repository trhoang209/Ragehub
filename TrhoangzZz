local aimKeyDown = false
local locked = nil

local function matchAimKey(input)
    local k = CONFIG.aimKey
    if k == "LMB" then return input.UserInputType == Enum.UserInputType.MouseButton1 end
    if k == "RMB" then return input.UserInputType == Enum.UserInputType.MouseButton2 end
    if k == "Q" then return input.KeyCode == Enum.KeyCode.Q end
    if k == "E" then return input.KeyCode == Enum.KeyCode.E end
    return false
end

local function aimPoint(character)
    if CONFIG.aimPart == "Torso" then
        local torso = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if torso then return torso.Position end
    end
    local head = character:FindFirstChild("Head")
    if head then return head.Position end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position or nil
end

local function targetValid(player)
    if player == LocalPlayer then return false end
    local character = player.Character
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not passesFilter(player) then return false end
    if not aimPoint(character) then return false end
    return true
end

local function fovDist(player)
    local pos = aimPoint(player.Character)
    if not pos then return nil end
    local sp, on = toScreen(pos)
    if not on then return nil end
    return (sp - screenCenter()).Magnitude
end

local function pickTarget()
    local best, bestD = nil, CONFIG.fovRadius
    for _, player in ipairs(Players:GetPlayers()) do
        if targetValid(player) then
            local d = fovDist(player)
            if d and d <= bestD then best, bestD = player, d end
        end
    end
    return best
end

local function aimAt(player)
    local character = player.Character
    if not character then return end
    local pos = aimPoint(character)
    if not pos then return end
    if CONFIG.aimMethod == "Camera" then
        local targetCF = CFrame.new(Camera.CFrame.Position, pos)
        local factor = math.clamp((11 - CONFIG.smooth) * 0.12, 0.05, 1)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, factor)
    else
        if not MOUSE_OK then return end
        local sp, on = toScreen(pos)
        if not on then return end
        local c = screenCenter()
        local factor = (11 - CONFIG.smooth) * 0.06
        mousemoverel((sp.X - c.X) * factor, (sp.Y - c.Y) * factor)
    end
end

local function aimStep()
    if not (CONFIG.enabled and CONFIG.aimlock) then locked = nil; return end
    if not aimKeyDown then locked = nil; return end
    if locked and targetValid(locked) then
        local d = fovDist(locked)
        if d and d <= CONFIG.fovRadius then aimAt(locked); return end
    end
    locked = pickTarget()
    if locked then aimAt(locked) end
end

local function fovStep()
    if fovCircle then
        fovCircle.Position = screenCenter()
        fovCircle.Radius = CONFIG.fovRadius
        fovCircle.Color = CONFIG.fovColor
        fovCircle.Thickness = CONFIG.fovThickness
        fovCircle.Visible = CONFIG.enabled and CONFIG.aimlock and CONFIG.showFov
    end
end

--------------------------------------------------------------------
-- MAIN LOOP
--------------------------------------------------------------------
local renderConn = RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return end
    fovStep()
    enemyCount = 0
    if not CONFIG.enabled then
        for _, e in pairs(cache) do hideEntry(e) end
        if countText then countText.Visible = false end
        if countText2 then countText2.Visible = false end
        return
    end
    revealStep()
    local list = Players:GetPlayers()
    for i = 1, #list do
        local player = list[i]
        if player ~= LocalPlayer then pcall(renderPlayer, player) end
    end
    if countText then
        local txt = tostring(enemyCount)
        -- đẩy số lên y=2 để line (bắt đầu từ y=55) không chạm midpoint vào số
        local pos = Vector2.new(Camera.ViewportSize.X * 0.5, 2)
        countText.Text = txt
        countText.Position = pos
        countText.Visible = CONFIG.tracer
        if countText2 then
            countText2.Text = txt
            countText2.Position = pos + Vector2.new(1, 1)
            countText2.Visible = CONFIG.tracer
        end
    end
    aimStep()
end)

