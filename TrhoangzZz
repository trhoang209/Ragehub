local function waitWhilePaused()
    while RUNNING and PAUSED do task.wait(0.2) end
    return RUNNING
end

local function remoteRoot()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    local root = packages and packages:FindFirstChild("Networking")
    return root or ReplicatedStorage:FindFirstChild("Network")
end

local function invoke(key, ...)
    local root = remoteRoot()
    if not root then return false, "network root missing" end

    local name = REMOTES[key] or key
    local remote = root:FindFirstChild(name)
    if not remote and name:sub(1, 3) == "RF/" then
        remote = root:FindFirstChild(name:gsub("^RF/", "RE/"))
    elseif not remote and name:sub(1, 3) == "RE/" then
        remote = root:FindFirstChild(name:gsub("^RE/", "RF/"))
    end
    if not remote then return false, "remote missing: " .. name end

    local args = table.pack(...)
    if remote:IsA("RemoteFunction") then
        local result = table.pack(pcall(function()
            return remote:InvokeServer(table.unpack(args, 1, args.n))
        end))
        if not result[1] then return false, tostring(result[2]) end
        return true, table.unpack(result, 2, result.n)
    elseif remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
        local ok, err = pcall(function()
            remote:FireServer(table.unpack(args, 1, args.n))
        end)
        return ok, ok and true or tostring(err)
    end
    return false, "unsupported remote type: " .. remote.ClassName
end

local function requireDirectory(path)
    local node = ReplicatedStorage
    for segment in path:gmatch("[^%.]+") do
        node = node and node:FindFirstChild(segment)
    end
    if not node or not node:IsA("ModuleScript") then return nil end
    local ok, value = pcall(require, node)
    if not ok or type(value) ~= "table" then return nil end
    if type(value.Directory) == "table" then return value.Directory, value end
    return value, value
end

