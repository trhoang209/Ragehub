-- INPUT
--------------------------------------------------------------------
local inputConn, endedConn
inputConn = UIS.InputBegan:Connect(function(input, processed)
    if input.KeyCode == CONFIG.toggleKey and not processed then
        CONFIG.enabled = not CONFIG.enabled
        refreshAll()
    elseif input.KeyCode == CONFIG.unloadKey and not processed then
        _G.nyx_esp_unload()
    elseif matchAimKey(input) and not processed then
        aimKeyDown = true
    end
end)
endedConn = UIS.InputEnded:Connect(function(input)
    if matchAimKey(input) then aimKeyDown = false end
end)

--------------------------------------------------------------------
-- LIFECYCLE
--------------------------------------------------------------------
local function wire(player)
    if player == LocalPlayer then return end
    entryFor(player)
    player.CharacterAdded:Connect(function(character)
        task.spawn(onCharacter, player, character)
    end)
    player.CharacterRemoving:Connect(function()
        local e = cache[player]
        if e then hideEntry(e) end
    end)
    if player.Character then task.spawn(onCharacter, player, player.Character) end
end

for _, player in ipairs(Players:GetPlayers()) do wire(player) end
local addedConn = Players.PlayerAdded:Connect(wire)
local removingConn = Players.PlayerRemoving:Connect(function(player)
    local e = cache[player]
    if not e then return end
    killEntry(e)
    cache[player] = nil
end)

--------------------------------------------------------------------
-- UNLOAD
--------------------------------------------------------------------
_G.nyx_esp_unload = function()
    if renderConn then renderConn:Disconnect() end
    if inputConn then inputConn:Disconnect() end
    if endedConn then endedConn:Disconnect() end
    if addedConn then addedConn:Disconnect() end
    if removingConn then removingConn:Disconnect() end
    if fovCircle then pcall(function() fovCircle:Remove() end) end
    if countText then pcall(function() countText:Remove() end) end
    if countText2 then pcall(function() countText2:Remove() end) end
    for _, e in pairs(cache) do killEntry(e) end
    table.clear(cache)
    applyFixLag(false)
    pcall(function() gui:Destroy() end)
    print("[RageHub] unloaded")
end

